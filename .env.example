# Example values for a self-hosted n8n deployment.
# Never commit a populated .env file.

OPENAI_API_KEY=replace_with_your_openai_api_key
GOOGLE_CLIENT_ID=replace_with_your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=replace_with_your_google_oauth_client_secret
GOOGLE_SHEET_ID=replace_with_your_google_sheet_id
GOOGLE_SHEET_NAME=Sheet1
REPORT_RECIPIENT_EMAIL=you@example.com
N8N_ENCRYPTION_KEY=replace_with_a_long_random_value
